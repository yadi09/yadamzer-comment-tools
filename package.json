{
  "name": "yadamzer-comment-tools",
  "version": "1.0.0",
  "description": "CLI tool to hide and unhide developer comments in React + TypeScript projects",
  "main": "dist/index.js",
  "bin": {
    "comment-tools": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli", 
    "comments", 
    "react", 
    "typescript", 
    "development",
    "code-cleanup",
    "documentation",
    "developer-tools",
    "comment-hiding",
    "production-ready"
  ],
  "author": "Yadamzer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/yadamzer-comment-tools.git"
  },
  "homepage": "https://github.com/yourusername/yadamzer-comment-tools#readme",
  "bugs": {
    "url": "https://github.com/yourusername/yadamzer-comment-tools/issues"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "nanoid": "^5.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.0"
  }
} 